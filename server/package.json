{
  "name": "backend",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "db:schema": "node db/setupDatabase.js",
    "db:derived": "node db/setupDatabase.js --derived",
    "bench": "node bench/run.js",
    "bench:report": "node bench/report.js"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "embedded-postgres": "^17.5.0-beta.15",
    "jest": "^29.7.0",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "globalSetup": "<rootDir>/test/helpers/globalSetup.js",
    "globalTeardown": "<rootDir>/test/helpers/globalTeardown.js",
    "setupFiles": [
      "<rootDir>/test/helpers/env.js"
    ],
    "collectCoverageFrom": [
      "app.js",
      "cache.js",
      "config.js",
      "db.js",
      "routes_optimized.js",
      "db/runSql.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "statements": 90,
        "functions": 90,
        "branches": 80
      }
    }
  }
}
